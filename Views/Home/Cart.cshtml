@{
    ViewData["Title"] = "Cart";
    var stripeReady = ViewData["StripeReady"] as bool? ?? false;
}

<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-3xl font-black text-white">Your cart</h1>
        <p class="mt-2 text-slate-400">Saved locally in the browser, so it keeps working without a backend checkout yet.</p>
    </div>
    <div class="flex flex-wrap gap-3">
        <form id="checkoutForm" asp-action="Checkout" method="post" class="inline-flex">
            @Html.AntiForgeryToken()
            <input type="hidden" name="quantity" id="cartQuantity" value="0" />
            <button id="payNowBtn" class="rounded-full bg-slate-600 px-4 py-2 text-sm font-semibold text-slate-300 transition" type="submit" disabled>
                Pay Now
            </button>
        </form>
        <button class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10" onclick="clearCart()" type="button">
            Clear cart
        </button>
    </div>
</div>

<div id="checkoutBanner" class="mt-6 hidden rounded-2xl border border-emerald-400/20 bg-emerald-400/10 p-4 text-sm text-emerald-100"></div>
@if (TempData["CheckoutError"] is string checkoutError && !string.IsNullOrWhiteSpace(checkoutError))
{
    <div class="mt-6 rounded-2xl border border-rose-400/20 bg-rose-400/10 p-4 text-sm text-rose-100">
        @checkoutError
    </div>
}
<div id="cartItems" class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3"></div>

<script>
    const container = document.getElementById("cartItems");
    const payNowBtn = document.getElementById("payNowBtn");
    const checkoutBanner = document.getElementById("checkoutBanner");
    const checkoutForm = document.getElementById("checkoutForm");
    const cartQuantityInput = document.getElementById("cartQuantity");
    const stripeReady = @stripeReady.ToString().ToLowerInvariant();

    function loadCart() {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        if (cartQuantityInput) {
            cartQuantityInput.value = cart.length;
        }
        updatePayNowState(cart.length);

        if (cart.length === 0) {
            container.innerHTML = `
                <div class="rounded-3xl border border-white/10 bg-white/5 p-8 text-slate-300 md:col-span-2 xl:col-span-3">
                    Your cart is empty.
                </div>`;
            return;
        }

        container.innerHTML = cart.map((item, index) => `
            <article class="overflow-hidden rounded-3xl border border-white/10 bg-white/5">
                <img src="${item.image}" alt="${item.name}" class="h-56 w-full object-cover" />
                <div class="space-y-4 p-6">
                    <h2 class="text-xl font-bold text-white">${item.name}</h2>
                    <button class="rounded-full bg-rose-500 px-4 py-2 text-sm font-semibold text-white" onclick="removeItem(${index})">
                        Remove
                    </button>
                </div>
            </article>
        `).join("");
    }

    function removeItem(index) {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        cart.splice(index, 1);
        localStorage.setItem("cart", JSON.stringify(cart));
        loadCart();
        updateCartCount();
    }

    function clearCart() {
        localStorage.removeItem("cart");
        loadCart();
        updateCartCount();
    }

    function updatePayNowState(count) {
        if (!payNowBtn) return;

        if (count > 0 && stripeReady) {
            payNowBtn.disabled = false;
            payNowBtn.className = "rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-500";
        } else {
            payNowBtn.disabled = true;
            payNowBtn.className = "rounded-full bg-slate-600 px-4 py-2 text-sm font-semibold text-slate-300 transition";
        }
    }

    if (new URLSearchParams(window.location.search).get("checkout") === "success") {
        localStorage.removeItem("cart");
        if (checkoutBanner) {
            checkoutBanner.textContent = "Payment completed successfully.";
            checkoutBanner.classList.remove("hidden");
        }
    }

    if (checkoutForm) {
        checkoutForm.addEventListener("submit", () => {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            if (cartQuantityInput) {
                cartQuantityInput.value = cart.length;
            }
            if (!stripeReady || cart.length === 0) {
                return;
            }
            payNowBtn.innerText = "Opening...";
        });
    }

    loadCart();
    payNowBtn.innerText = "Pay Now";
</script>
