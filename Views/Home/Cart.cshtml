@model ErrorViewModel
@{
    ViewData["Title"] = "Cart";
    var stripeReady = ViewData["StripeReady"] as bool? ?? false;
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<!-- Header Section -->
<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-3xl font-black text-white">Your cart</h1>
        <div class="mt-2 flex items-center gap-2">
            @if (isAuthenticated)
            {
                <div class="flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-400 border border-emerald-500/20">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    Using a Backend checkout
                </div>
            }
            else
            {
                <p class="text-slate-400 text-sm">Guest session — <span class="text-blue-400">Sign in to enable backend checkout</span></p>
            }
        </div>
    </div>
    
    <div class="flex flex-wrap gap-3">
        @if (isAuthenticated)
        {
            <form id="checkoutForm" asp-action="Checkout" method="post" class="inline-flex">
                @Html.AntiForgeryToken()
                <input type="hidden" name="quantity" id="cartQuantity" value="0" />
                <button id="payNowBtn" class="rounded-full bg-slate-600 px-4 py-2 text-sm font-semibold text-slate-300 transition" type="submit" disabled>
                    Pay Now
                </button>
            </form>
        }
        else
        {
            <a href="/Home/Account?returnUrl=/Home/Cart" class="rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-500 shadow-lg shadow-blue-900/20">
                Sign in to Checkout
            </a>
        }
        
        <button class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10" onclick="clearCart()" type="button">
            Clear cart
        </button>
    </div>
</div>

<!-- EXIT INTENT MODAL -->
<div id="exitModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4 text-center">
    <div class="max-w-md w-full rounded-3xl border border-white/10 bg-slate-900 p-8 shadow-2xl">
        <div class="mb-4 inline-flex h-16 w-16 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
        </div>
        <h2 class="text-2xl font-bold text-white">Wait! Save your items.</h2>
        <p class="mt-3 text-slate-400">To use our secure <strong>Backend Checkout</strong> and save your items, you need to be signed in.</p>
        
        <div class="mt-8 flex flex-col gap-3">
            <a href="/Home/Account?returnUrl=/Home/Cart" class="rounded-full bg-white px-6 py-3 font-bold text-black transition hover:bg-slate-200">
                Sign in to Pay
            </a>
            <button onclick="closeModalAndStay()" class="rounded-full border border-white/10 bg-white/5 px-6 py-3 font-semibold text-white transition hover:bg-white/10">
                Keep Shopping
            </button>
            <button onclick="discardAndLeave()" class="text-sm text-slate-500 hover:text-rose-400 transition mt-2">
                Discard and leave
            </button>
        </div>
    </div>
</div>

<div id="checkoutBanner" class="mt-6 hidden rounded-2xl border border-emerald-400/20 bg-emerald-400/10 p-4 text-sm text-emerald-100"></div>

@if (TempData["CheckoutError"] is string checkoutError && !string.IsNullOrWhiteSpace(checkoutError))
{
    <div class="mt-6 rounded-2xl border border-rose-400/20 bg-rose-400/10 p-4 text-sm text-rose-100">
        @checkoutError
    </div>
}

<div id="cartItems" class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3"></div>

<script>
    const container = document.getElementById("cartItems");
    const payNowBtn = document.getElementById("payNowBtn");
    const checkoutBanner = document.getElementById("checkoutBanner");
    const checkoutForm = document.getElementById("checkoutForm");
    const cartQuantityInput = document.getElementById("cartQuantity");
    const exitModal = document.getElementById("exitModal");
    
    const stripeReady = @stripeReady.ToString().ToLowerInvariant();
    const isAuthenticated = @isAuthenticated.ToString().ToLowerInvariant();

    function loadCart() {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        if (cartQuantityInput) {
            cartQuantityInput.value = cart.length;
        }
        
        updatePayNowState(cart.length);

        if (cart.length === 0) {
            container.innerHTML = `
                <div class="rounded-3xl border border-white/10 bg-white/5 p-8 text-slate-300 md:col-span-2 xl:col-span-3">
                    Your cart is empty.
                </div>`;
            return;
        }

        container.innerHTML = cart.map((item, index) => `
            <article class="overflow-hidden rounded-3xl border border-white/10 bg-white/5">
                <img src="${item.image}" alt="${item.name}" class="h-56 w-full object-cover" />
                <div class="space-y-4 p-6">
                    <h2 class="text-xl font-bold text-white">${item.name}</h2>
                    <button class="rounded-full bg-rose-500/10 px-4 py-2 text-sm font-semibold text-rose-500 transition hover:bg-rose-500 hover:text-white" onclick="removeItem(${index})">
                        Remove
                    </button>
                </div>
            </article>
        `).join("");
    }

    // --- EXIT INTENT ---
    document.addEventListener("mouseleave", (e) => {
        if (e.clientY < 0 && !isAuthenticated) {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            if(cart.length > 0) exitModal.classList.replace("hidden", "flex");
        }
    });

    function closeModalAndStay() {
        exitModal.classList.replace("flex", "hidden");
    }

    function discardAndLeave() {
        localStorage.removeItem("cart");
        window.location.href = "/";
    }

    // --- CART LOGIC ---
    function removeItem(index) {
        const cart = JSON.parse(localStorage.getItem("cart")) || [];
        cart.splice(index, 1);
        localStorage.setItem("cart", JSON.stringify(cart));
        loadCart();
    }

    function clearCart() {
        localStorage.removeItem("cart");
        loadCart();
    }

    function updatePayNowState(count) {
        if (!payNowBtn) return;

        if (count > 0 && stripeReady && isAuthenticated) {
            payNowBtn.disabled = false;
            payNowBtn.className = "rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-500 shadow-lg shadow-emerald-900/40";
        } else {
            payNowBtn.disabled = true;
            payNowBtn.className = "rounded-full bg-slate-600 px-4 py-2 text-sm font-semibold text-slate-300 transition cursor-not-allowed opacity-50";
        }
    }

    if (new URLSearchParams(window.location.search).get("checkout") === "success") {
        localStorage.removeItem("cart");
        if (checkoutBanner) {
            checkoutBanner.textContent = "Thank you! Backend processing complete.";
            checkoutBanner.classList.remove("hidden");
        }
    }

    if (checkoutForm) {
        checkoutForm.addEventListener("submit", () => {
            const cart = JSON.parse(localStorage.getItem("cart")) || [];
            cartQuantityInput.value = cart.length;
            payNowBtn.innerText = "Connecting to Stripe...";
        });
    }

    loadCart();
</script>