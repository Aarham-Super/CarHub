@{
    var statusCode = (int)(ViewData["StatusCode"] ?? 404);
    var message = ViewData["Message"] as string ?? "Something went wrong.";
    ViewData["Title"] = statusCode switch
    {
        400 => "Bad request",
        401 => "Unauthorized",
        403 => "Forbidden",
        404 => "Page not found",
        500 => "Server error",
        _ => "Error"
    };
}

<section class="mx-auto max-w-3xl rounded-3xl border border-white/10 bg-white/5 p-8 text-center shadow-glow">
    <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-2xl bg-orange-400/15 text-3xl font-black text-orange-300">
        @statusCode
    </div>
    <h1 class="mt-6 text-4xl font-black text-white">
        @(statusCode switch
        {
            400 => "Bad request",
            401 => "Unauthorized",
            403 => "Access denied",
            404 => "Page not found",
            500 => "Server error",
            _ => "Something went wrong"
        })
    </h1>
    <p class="mt-4 text-base leading-7 text-slate-300">@message</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-full bg-accent px-5 py-3 font-semibold text-white">Back home</a>
        <a href="/Home/Cars" class="rounded-full border border-white/10 bg-white/5 px-5 py-3 font-semibold text-white">Browse cars</a>
        <a href="/Home/Account" class="rounded-full border border-white/10 bg-white/5 px-5 py-3 font-semibold text-white">Account</a>
    </div>
</section>
