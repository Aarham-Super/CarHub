@{
    ViewData["Title"] = "3D Car Viewer";
}

<section class="space-y-6">
    <div class="grid gap-6 xl:grid-cols-[1.05fr_0.95fr]">
        <div class="space-y-4">
            <div>
                <h1 class="page-title text-3xl font-black text-white">Real 3D car viewer</h1>
                <p class="page-copy mt-2 max-w-2xl text-slate-400">
                    This viewer now uses real Sketchfab car models instead of a block placeholder. Each selection loads a different vehicle so the page actually feels like a 3D garage.
                </p>
            </div>

            <div class="overflow-hidden rounded-3xl border border-white/10 bg-slate-900/80 p-3 shadow-glow sm:p-4">
                <iframe id="sketchfabViewer"
                        title="CarHub 3D model viewer"
                        class="h-[420px] w-full rounded-2xl border border-white/10 bg-black sm:h-[620px]"
                        allow="autoplay; fullscreen; xr-spatial-tracking"
                        allowfullscreen
                        mozallowfullscreen="true"
                        webkitallowfullscreen="true"
                        src="https://sketchfab.com/models/c45388786e7148e4be197913820808d1/embed?autostart=1&autospin=0.2&camera=0&transparent=1&ui_infos=0&ui_controls=1">
                </iframe>
            </div>
        </div>

        <aside class="space-y-4 rounded-3xl border border-white/10 bg-white/5 p-6">
            <div>
                <h2 class="text-2xl font-bold text-white">Model selector</h2>
                <p class="mt-1 text-sm text-slate-400">Pick a real model. These are different files, not the same geometry with a different label.</p>
            </div>

            <div class="space-y-3">
                <button type="button" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-left transition hover:border-orange-400/40 hover:bg-white/5" onclick="setModel('urus')">
                    <div class="font-semibold text-white">Lamborghini Urus</div>
                    <div class="text-sm text-slate-400">Sketchfab model, CC Attribution</div>
                </button>
                <button type="button" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-left transition hover:border-orange-400/40 hover:bg-white/5" onclick="setModel('huracan')">
                    <div class="font-semibold text-white">Lamborghini Huracan</div>
                    <div class="text-sm text-slate-400">Sketchfab model, CC Attribution</div>
                </button>
                <button type="button" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-left transition hover:border-orange-400/40 hover:bg-white/5" onclick="setModel('supercar')">
                    <div class="font-semibold text-white">Supercar</div>
                    <div class="text-sm text-slate-400">High-detail car model, CC Attribution</div>
                </button>
                <button type="button" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-left transition hover:border-orange-400/40 hover:bg-white/5" onclick="setModel('suv')">
                    <div class="font-semibold text-white">SUV</div>
                    <div class="text-sm text-slate-400">Realistic SUV model, CC Attribution</div>
                </button>
            </div>

            <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4 text-sm leading-6 text-slate-300">
                Drag inside the viewer to rotate, scroll to zoom, and use fullscreen if you want a closer look.
            </div>
        </aside>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <div class="text-xs uppercase tracking-[0.3em] text-slate-500">Source</div>
            <div id="viewerLabel" class="mt-2 text-xl font-bold text-white">Lamborghini Urus</div>
            <p id="viewerCredit" class="mt-2 text-sm leading-6 text-slate-400">
                Sketchfab model by idan kuzi, licensed CC Attribution.
            </p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <div class="text-xs uppercase tracking-[0.3em] text-slate-500">Why this is better</div>
            <p class="mt-2 text-sm leading-6 text-slate-400">
                The old viewer was drawn from simple geometry. This one loads full authored models from an external 3D host, which is why it looks like an actual car instead of a placeholder.
            </p>
        </div>
    </div>
</section>

<script>
    const models = {
        urus: {
            src: "https://sketchfab.com/models/c45388786e7148e4be197913820808d1/embed?autostart=1&autospin=0.2&camera=0&transparent=1&ui_infos=0&ui_controls=1",
            label: "Lamborghini Urus",
            credit: "Sketchfab model by idan kuzi, licensed CC Attribution."
        },
        huracan: {
            src: "https://sketchfab.com/models/b2f5c24c44fd417fb89286603af9b5a5/embed?autostart=1&autospin=0.2&camera=0&transparent=1&ui_infos=0&ui_controls=1",
            label: "Lamborghini Huracan",
            credit: "Sketchfab model by jpo1703, licensed CC Attribution."
        },
        supercar: {
            src: "https://sketchfab.com/models/e0d1c15886c443e3afce1347979d36fe/embed?autostart=1&autospin=0.2&camera=0&transparent=1&ui_infos=0&ui_controls=1",
            label: "Supercar",
            credit: "Sketchfab model by Nordener, licensed CC Attribution."
        },
        suv: {
            src: "https://sketchfab.com/models/b3749cb36f674e359b6b204fa8ffcf55/embed?autostart=1&autospin=0.2&camera=0&transparent=1&ui_infos=0&ui_controls=1",
            label: "SUV",
            credit: "Sketchfab model by ShreyanshChaurasia_13, licensed CC Attribution."
        }
    };

    function setModel(key) {
        const model = models[key] || models.urus;
        const iframe = document.getElementById("sketchfabViewer");
        const label = document.getElementById("viewerLabel");
        const credit = document.getElementById("viewerCredit");

        iframe.src = model.src;
        label.textContent = model.label;
        credit.textContent = model.credit;
    }
</script>
