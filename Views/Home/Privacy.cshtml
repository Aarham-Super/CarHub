@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-black text-white">Privacy Policy</h1>
        <p class="mt-2 text-slate-400">This is a lightweight local showcase app. The core data today lives in browser storage and static assets.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="font-semibold text-white">1. Data collection</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Only simple browsing state, cookie consent, and cart items are stored locally by the browser.</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="font-semibold text-white">2. Data usage</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">User accounts are kept in the SQLite fallback store so Google, GitHub, and email sign-ins point to the same saved profile.</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="font-semibold text-white">3. External services</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Stripe credentials are intentionally placeholders until you add your real keys in appsettings.json.</p>
        </div>
    </div>
</div>
