@{
    ViewData["Title"] = "Terms of Use";
}

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-black text-white">Terms of Use</h1>
        <p class="mt-2 text-slate-400">These terms are written for a showcase app and can be expanded later when checkout or accounts are added.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="font-semibold text-white">1. Acceptance</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Using CarHub means you accept the current showcase and browser-storage behavior.</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="font-semibold text-white">2. Media use</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">All external media credits must remain visible and linked to their Commons source pages.</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="font-semibold text-white">3. Future payments</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Stripe is configured as a placeholder only until real keys and checkout logic are added.</p>
        </div>
    </div>

    <div class="rounded-3xl border border-amber-400/20 bg-amber-400/10 p-6">
        <h2 class="text-xl font-bold text-white">No refund policy</h2>
        <p class="mt-3 text-sm leading-6 text-amber-50/90">
            All sales are final. CarHub does not offer refunds, chargebacks, or order reversals after a purchase is completed, except where required by law.
            Please review your order carefully before confirming payment.
        </p>
    </div>
</div>
