@{
    ViewData["Title"] = "Terms of Use";
}

<div class="space-y-6">
    <div>
        <h1 class="text-4xl font-black text-white sm:text-5xl">Terms of Use</h1>
        <p class="mt-3 max-w-4xl text-base leading-7 text-slate-300 sm:text-lg">
            These terms are written for a showcase app and can be expanded later when checkout or accounts are added.
        </p>
    </div>

    <div class="rounded-3xl border border-orange-400/30 bg-orange-400/10 p-6 sm:p-8">
        <h2 class="text-2xl font-black text-white sm:text-3xl">Important notice</h2>
        <p class="mt-4 text-lg leading-8 text-orange-50/95 sm:text-xl">
            No real car will be delivered to your home.
        </p>
        <p class="mt-3 max-w-4xl text-base leading-7 text-orange-50/80">
            CarHub is a digital showcase and browsing experience. Any purchases, checkout steps, or car pages are for online demo purposes only unless a separate written agreement says otherwise.
        </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="text-xl font-bold text-white">1. Acceptance</h2>
            <p class="mt-3 text-base leading-7 text-slate-300">Using CarHub means you accept the current showcase and browser-storage behavior.</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="text-xl font-bold text-white">2. Media use</h2>
            <p class="mt-3 text-base leading-7 text-slate-300">All external media credits must remain visible and linked to their source pages.</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="text-xl font-bold text-white">3. Future payments</h2>
            <p class="mt-3 text-base leading-7 text-slate-300">Stripe is configured as a placeholder only until real keys and checkout logic are added.</p>
        </div>
    </div>

    <div class="rounded-3xl border border-amber-400/20 bg-amber-400/10 p-6">
        <h2 class="text-2xl font-black text-white">No refund policy</h2>
        <p class="mt-4 text-base leading-7 text-amber-50/95 sm:text-lg">
            All sales are final. CarHub does not offer refunds, chargebacks, or order reversals after a purchase is completed, except where required by law.
            Please review your order carefully before confirming payment.
        </p>
    </div>
</div>
