@{
    ViewData["Title"] = "EULA";
}

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-black text-white">CarHub EULA</h1>
        <p class="mt-2 text-slate-400">A short, readable placeholder license page for the current showcase build.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="font-semibold text-white">1. License</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">You may use CarHub for local showcase and demo purposes.</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="font-semibold text-white">2. Restrictions</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">Do not redistribute the site as a commercial product without adding your own licensing terms.</p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="font-semibold text-white">3. Assets</h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">All Wikimedia Commons assets must continue to carry proper attribution and license links.</p>
        </div>
    </div>
</div>
