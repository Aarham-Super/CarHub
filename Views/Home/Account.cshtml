@model CarHub.Models.AccountViewModel
@{
    ViewData["Title"] = "Account";
    var isSuccess = string.Equals(Model.MessageType, "success", StringComparison.OrdinalIgnoreCase);
    var isAuthenticated = Model.IsAuthenticated || User.Identity?.IsAuthenticated == true;
}

<section class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="space-y-6">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-glow sm:p-8">
            <span class="inline-flex rounded-full border border-blue-400/30 bg-blue-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.3em] text-blue-200">
                Account access
            </span>
            <h1 class="page-title mt-5 text-4xl font-black text-white">Email login, Google, GitHub, and saved profile data</h1>
            <p class="page-copy mt-4 text-slate-300">
                CarHub keeps each user in SQLite so the same account stays intact when you sign in with email, Google, or GitHub.
            </p>

            <div class="mt-6 grid gap-3 sm:grid-cols-2">
                <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
                    <div class="text-xs uppercase tracking-[0.3em] text-slate-500">Reset sender</div>
                    <div class="mt-2 text-lg font-semibold text-white">CarrHub@hotmail.com</div>
                    <div class="mt-1 text-sm text-slate-400">Used for the 5-digit reset code flow.</div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
                    <div class="text-xs uppercase tracking-[0.3em] text-slate-500">Saved profile</div>
                    <div class="mt-2 text-lg font-semibold text-white">Username, email, 2FA, passkey state</div>
                    <div class="mt-1 text-sm text-slate-400">Persists across Google and GitHub sign-in.</div>
                </div>
            </div>
        </div>

        @if (isAuthenticated)
        {
            <div class="rounded-3xl border border-emerald-400/20 bg-emerald-400/10 p-6">
                <div class="text-xs uppercase tracking-[0.3em] text-emerald-200/70">Signed in</div>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                    <div class="rounded-2xl border border-emerald-400/20 bg-slate-950/50 p-4">
                        <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Username</div>
                        <div class="mt-2 text-lg font-bold text-white">@((Model.UserName ?? Model.DisplayName ?? Model.SignedInEmail) ?? "CarHub user")</div>
                    </div>
                    <div class="rounded-2xl border border-emerald-400/20 bg-slate-950/50 p-4">
                        <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Email</div>
                        <div class="mt-2 text-lg font-bold text-white">@((Model.SignedInEmail) ?? "n/a")</div>
                    </div>
                    <div class="rounded-2xl border border-emerald-400/20 bg-slate-950/50 p-4">
                        <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Provider</div>
                        <div class="mt-2 text-lg font-bold text-white">@((Model.SignedInProvider ?? "local").ToUpperInvariant())</div>
                    </div>
                    <div class="rounded-2xl border border-emerald-400/20 bg-slate-950/50 p-4">
                        <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Security</div>
                        <div class="mt-2 text-lg font-bold text-white">@(Model.TwoFactorEnabled ? "2FA enabled" : "2FA off")</div>
                    </div>
                </div>

                <form asp-action="Logout" method="post" class="mt-5">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-full border border-white/10 bg-white/5 px-5 py-3 font-semibold text-white transition hover:border-orange-400/40 hover:bg-white/10">
                        Sign out
                    </button>
                </form>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="rounded-2xl border p-4 text-sm @(isSuccess ? "border-emerald-400/20 bg-emerald-400/10 text-emerald-100" : "border-rose-400/20 bg-rose-400/10 text-rose-100")">
                @Model.Message
            </div>

            @if (isSuccess && !string.IsNullOrWhiteSpace(Model.GeneratedResetCode))
            {
                <div class="rounded-2xl border border-blue-400/20 bg-blue-400/10 p-4 text-sm text-blue-100">
                    <div class="font-semibold">Reset code</div>
                    <div class="mt-2 text-2xl font-black tracking-[0.35em]">@Model.GeneratedResetCode</div>
                    <div class="mt-2 text-blue-100/80">
                        If SMTP is not configured yet, this code is shown here for local testing.
                    </div>
                </div>
            }
        }

        @if (isAuthenticated)
        {
            <div class="grid gap-4 xl:grid-cols-2">
                <form method="post" class="rounded-3xl border border-white/10 bg-slate-900/80 p-6 shadow-glow sm:p-7">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FormAction" value="profile" />
                    <input type="hidden" asp-for="Email" value="@Model.SignedInEmail" />
                    <h2 class="text-xl font-bold text-white">Settings</h2>
                    <p class="mt-2 text-sm text-slate-400">Update the username that stays attached to your account.</p>

                    <div class="mt-5 space-y-4">
                        <div class="space-y-2">
                            <label class="text-sm font-semibold text-slate-200" for="ProfileDisplayName">Username</label>
                            <input asp-for="DisplayName" id="ProfileDisplayName" autocomplete="nickname" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="Your username" />
                        </div>
                    </div>

                    <button type="submit" class="mt-5 w-full rounded-full bg-accent px-5 py-3 font-semibold text-white transition hover:bg-orange-500">
                        Save settings
                    </button>
                </form>

                <form method="post" class="rounded-3xl border border-white/10 bg-slate-900/80 p-6 shadow-glow sm:p-7">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="FormAction" value="twofactor" />
                    <input type="hidden" asp-for="Email" value="@Model.SignedInEmail" />
                    <h2 class="text-xl font-bold text-white">Two-factor</h2>
                    <p class="mt-2 text-sm text-slate-400">Turn this on to mark the account as protected. You can wire authenticator or SMS later.</p>

                    <div class="mt-5 rounded-2xl border border-white/10 bg-slate-950 px-4 py-3">
                        <label class="flex items-center justify-between gap-4">
                            <span class="text-sm font-semibold text-slate-200">Enable two-factor</span>
                            <input asp-for="TwoFactorEnabled" type="checkbox" class="h-5 w-5 rounded border-slate-500 bg-slate-900 text-emerald-500" />
                        </label>
                    </div>

                    <button type="submit" class="mt-5 w-full rounded-full border border-white/10 bg-white/5 px-5 py-3 font-semibold text-white transition hover:border-orange-400/40 hover:bg-white/10">
                        Save security
                    </button>
                </form>
            </div>

            <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
                <div class="text-xs uppercase tracking-[0.3em] text-slate-500">Passkeys</div>
                <div class="mt-3 grid gap-4 md:grid-cols-[1.3fr_0.7fr] md:items-center">
                    <div>
                        <h2 class="text-xl font-bold text-white">Windows Hello and browser passkeys</h2>
                        <p class="mt-2 text-sm leading-6 text-slate-300">
                            The account record is ready for passkeys, but the WebAuthn challenge and verification flow still needs to be added before the browser can enroll a real device key.
                        </p>
                    </div>
                    <button type="button" disabled class="rounded-full border border-white/10 bg-slate-600/60 px-5 py-3 font-semibold text-slate-300 opacity-60 cursor-not-allowed">
                        Add passkey
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="space-y-6">
        <div class="grid gap-4 xl:grid-cols-2">
            <form method="post" class="rounded-3xl border border-white/10 bg-slate-900/80 p-6 shadow-glow sm:p-7">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormAction" value="signup" />
                <input type="hidden" asp-for="Provider" value="email" />
                <h2 class="text-xl font-bold text-white">Create account</h2>
                <p class="mt-2 text-sm text-slate-400">Use your email if you do not want Google or GitHub.</p>

                <div class="mt-5 space-y-4">
                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="SignupDisplayName">Username</label>
                        <input asp-for="DisplayName" id="SignupDisplayName" autocomplete="nickname" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="CarHub fan" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="SignupEmail">Email</label>
                        <input asp-for="Email" id="SignupEmail" autocomplete="email" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="you@example.com" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="SignupPassword">Password</label>
                        <input asp-for="Password" id="SignupPassword" autocomplete="new-password" type="password" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="Create a password" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="SignupConfirm">Confirm password</label>
                        <input asp-for="ConfirmPassword" id="SignupConfirm" autocomplete="new-password" type="password" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="Confirm your password" />
                    </div>

                    <div class="rounded-2xl border border-white/10 bg-slate-950/70 p-4">
                        <label class="flex items-start gap-3">
                            <input asp-for="AcceptTerms" type="checkbox" class="mt-1 h-5 w-5 rounded border-slate-500 bg-slate-900 text-emerald-500" />
                            <span class="text-sm leading-6 text-slate-300">
                                I accept the
                                <a href="/Home/Terms" class="text-orange-300 underline decoration-orange-400/50 underline-offset-4 hover:text-orange-200">Terms of Use</a>
                                and
                                <a href="/Home/Privacy" class="text-orange-300 underline decoration-orange-400/50 underline-offset-4 hover:text-orange-200">Privacy Policy</a>
                                for CarHub accounts.
                            </span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="mt-5 w-full rounded-full bg-accent px-5 py-3 font-semibold text-white transition hover:bg-orange-500">
                    Sign up with email
                </button>
            </form>

            <form method="post" class="rounded-3xl border border-white/10 bg-slate-900/80 p-6 shadow-glow sm:p-7">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormAction" value="signin" />
                <h2 class="text-xl font-bold text-white">Sign in</h2>
                <p class="mt-2 text-sm text-slate-400">Use the email and password you already created.</p>

                <div class="mt-5 space-y-4">
                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="SigninEmail">Email</label>
                        <input asp-for="Email" id="SigninEmail" autocomplete="email" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="you@example.com" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="SigninPassword">Password</label>
                        <input asp-for="Password" id="SigninPassword" autocomplete="current-password" type="password" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="Your password" />
                    </div>
                </div>

                <button type="submit" class="mt-5 w-full rounded-full border border-white/10 bg-white/5 px-5 py-3 font-semibold text-white transition hover:border-orange-400/40 hover:bg-white/10">
                    Sign in
                </button>
            </form>
        </div>

        <div class="grid gap-4 xl:grid-cols-2">
            <form method="post" class="rounded-3xl border border-white/10 bg-slate-900/80 p-6 shadow-glow sm:p-7">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormAction" value="forgot" />
                <h2 class="text-xl font-bold text-white">Forgot password</h2>
                <p class="mt-2 text-sm text-slate-400">Enter your email and we will generate a fresh code if an account exists.</p>

                <div class="mt-5 space-y-4">
                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="ForgotEmail">Email</label>
                        <input asp-for="Email" id="ForgotEmail" autocomplete="email" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="you@example.com" />
                    </div>
                </div>

                <button type="submit" class="mt-5 w-full rounded-full bg-blue-600 px-5 py-3 font-semibold text-white transition hover:bg-blue-500">
                    Send reset code
                </button>
            </form>

            <form method="post" class="rounded-3xl border border-white/10 bg-slate-900/80 p-6 shadow-glow sm:p-7">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormAction" value="reset" />
                <h2 class="text-xl font-bold text-white">Reset password</h2>
                <p class="mt-2 text-sm text-slate-400">Use the code you received. It expires after 15 minutes and cannot be reused.</p>

                <div class="mt-5 space-y-4">
                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="ResetEmail">Email</label>
                        <input asp-for="Email" id="ResetEmail" autocomplete="email" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="you@example.com" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="ResetCode">5-digit code</label>
                        <input asp-for="ResetCode" id="ResetCode" inputmode="numeric" maxlength="5" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white tracking-[0.35em]" placeholder="12345" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="NewPassword">New password</label>
                        <input asp-for="NewPassword" id="NewPassword" autocomplete="new-password" type="password" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="New password" />
                    </div>

                    <div class="space-y-2">
                        <label class="text-sm font-semibold text-slate-200" for="ResetConfirm">Confirm new password</label>
                        <input asp-for="ConfirmPassword" id="ResetConfirm" autocomplete="new-password" type="password" class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white" placeholder="Confirm password" />
                    </div>
                </div>

                <button type="submit" class="mt-5 w-full rounded-full bg-emerald-600 px-5 py-3 font-semibold text-white transition hover:bg-emerald-500">
                    Confirm new password
                </button>
            </form>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <div class="text-xs uppercase tracking-[0.3em] text-slate-500">Social sign-in</div>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <a asp-action="ExternalLogin" asp-route-provider="google" class="inline-flex w-full items-center justify-center rounded-full bg-blue-600 px-5 py-3 font-semibold text-white transition hover:bg-blue-500">
                    Sign up with Google
                </a>

                <a asp-action="ExternalLogin" asp-route-provider="github" class="inline-flex w-full items-center justify-center rounded-full bg-slate-800 px-5 py-3 font-semibold text-white transition hover:bg-slate-700">
                    Sign up with GitHub
                </a>
            </div>
            <div class="mt-4 text-sm text-slate-400">
                Google and GitHub accounts are merged into the same stored user record if the email matches.
            </div>
        </div>
    </div>
</section>
