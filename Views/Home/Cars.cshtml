@model IReadOnlyList<CarHub.Models.CarDetailViewModel>
@{
    ViewData["Title"] = "Cars";
}

<div class="mobile-stack items-start justify-between">
    <div>
        <h1 class="page-title text-3xl font-black text-white">Car catalog</h1>
        <p class="page-copy mt-2 text-slate-400">Every page routes to a real view and every image stays inside the local `wwwroot/images/cars` tree.</p>
    </div>
    <a href="/" class="text-sm font-semibold text-orange-300 hover:text-orange-200">Back home</a>
</div>

<div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    @foreach (var car in Model)
    {
        <article class="overflow-hidden rounded-3xl border border-white/10 bg-white/5">
            <img src="@car.HeroImage" alt="@car.DisplayName" class="h-56 w-full object-cover" />
            <div class="space-y-4 p-6">
                <div>
                    <h2 class="page-title text-xl font-bold text-white">@car.DisplayName</h2>
                    <p class="text-sm text-slate-400">@car.Segment</p>
                </div>
                <p class="page-copy text-sm leading-6 text-slate-300">@car.Description</p>
                <div class="mobile-grid-2 grid grid-cols-2 gap-3 text-sm text-slate-300">
                    <div class="rounded-2xl bg-slate-950/60 p-3">
                        <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Powertrain</div>
                        <div class="mt-1 font-semibold text-white">@car.Powertrain</div>
                    </div>
                    <div class="rounded-2xl bg-slate-950/60 p-3">
                        <div class="text-xs uppercase tracking-[0.25em] text-slate-500">Drive</div>
                        <div class="mt-1 font-semibold text-white">@car.Drivetrain</div>
                    </div>
                </div>
                <div class="mobile-stack">
                    <a href="/Cars/@car.RouteBrand/@car.RouteModel" class="rounded-full bg-accent px-4 py-2 text-center text-sm font-semibold text-white">Open page</a>
                    <button class="rounded-full border border-white/10 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10" onclick="addToCart('@car.DisplayName', '@car.HeroImage')">
                        Add to cart
                    </button>
                </div>
            </div>
        </article>
    }
</div>
